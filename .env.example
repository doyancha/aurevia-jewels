# Public deployment URL used for canonical URLs, sitemap entries, and social metadata.
# Replace with the Vercel production URL after the first deployment, or your owned domain later.
NEXT_PUBLIC_SITE_URL=https://aureviajewels.example
# Server-only Django catalog API base; Django must be running for local builds.
AUREVIA_CATALOG_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production: https://<railway-backend-domain>/api/v1 (server-only; never NEXT_PUBLIC_)
