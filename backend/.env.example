DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
# Production requires a strong non-placeholder value (50+ characters).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Optional production-only proxy opt-in; leave false until the proxy contract is verified.
DJANGO_TRUST_X_FORWARDED_PROTO=false

POSTGRES_DB=aurevia_jewels
POSTGRES_USER=aurevia_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Railway production prefers DATABASE_URL and must not use local defaults.
# DATABASE_URL=postgresql://<railway-user>:<password>@<private-host>:5432/<database>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
